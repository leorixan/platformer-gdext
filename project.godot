; Engine configuration file.
; Generated by hand: this project exists so the extension can be loaded and driven
; from the editor without pulling in the larger game it was extracted from.
;
;   scons            build the extension into addons/platformer_core/bin/
;   godot --path .   open this project (the demo scene needs the extension built)

config_version=5

[application]

config/name="platformer-core demo"
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0

